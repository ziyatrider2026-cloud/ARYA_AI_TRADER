# ==========================================================
# ARYA AI TRADER — نمونه فایل متغیرهای محیطی
# این فایل را کپی کنید به .env و مقادیر واقعی را جایگزین کنید:
#   cp .env.example .env
# فایل .env هرگز نباید در گیت commit شود (در .gitignore قرار دارد).
# ==========================================================

# ---------- 1) عمومی ----------
# محیط اجرا: development | production
NODE_ENV=development
# پورت سرور توسعه (اختیاری، پیش‌فرض 8080)
PORT=8080

# ---------- 2) متغیرهای سمت مرورگر (باید با VITE_ شروع شوند) ----------
# هشدار: هر مقدار VITE_* داخل باندل مرورگر قابل مشاهده است.
# هرگز کلید محرمانه را با پیشوند VITE_ قرار ندهید.
VITE_APP_NAME="ARYA AI TRADER"
# حالت داده: mock (داده نمونه) یا live (اتصال به پرووایدر واقعی)
VITE_DATA_MODE=mock

# ---------- 3) پرووایدرهای داده بازار (سمت سرور، محرمانه) ----------
# TSETMC / منبع داده بورس تهران
TSETMC_BASE_URL=https://cdn.tsetmc.com
TSETMC_API_KEY=

# کدال (اطلاعیه‌ها و صورت‌های مالی)
CODAL_BASE_URL=https://search.codal.ir
CODAL_API_KEY=

# داده کریپتو/جهانی (در صورت استفاده)
CRYPTO_API_KEY=

# ---------- 4) موتور هوش مصنوعی ----------
# در صورت استفاده از Lovable AI Gateway این مقدار به‌صورت خودکار تزریق می‌شود
LOVABLE_API_KEY=
# در صورت استفاده مستقیم از سرویس‌های دیگر
OPENAI_API_KEY=

# ---------- 5) پایگاه داده / احراز هویت (در صورت فعال‌سازی Lovable Cloud) ----------
# این مقادیر پس از فعال‌سازی به‌صورت خودکار ساخته می‌شوند
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 6) کلیدهای امنیتی داخلی ----------
# با دستور زیر بسازید: openssl rand -hex 32
SESSION_SECRET=
