# ==========================================================
# ARYA AI TRADER — نمونه فایل متغیرهای محیطی
# این فایل را کپی کنید به .env و مقادیر واقعی را جایگزین کنید:
#   cp .env.example .env
# فایل .env هرگز نباید در گیت commit شود (در .gitignore قرار دارد).
# ==========================================================

# ---------- 1) عمومی ----------
NODE_ENV=development
PORT=8080

# ---------- 2) متغیرهای سمت مرورگر ----------
# هشدار: هر مقدار VITE_* داخل باندل مرورگر قابل مشاهده است.
# هرگز کلید محرمانه را با پیشوند VITE_ قرار ندهید.
VITE_APP_NAME="ARYA AI TRADER"
VITE_DATA_MODE=mock

# ---------- 3) پرووایدرهای داده بازار (سمت سرور، محرمانه) ----------
TSETMC_BASE_URL=https://cdn.tsetmc.com
TSETMC_API_KEY=
CODAL_BASE_URL=https://search.codal.ir
CODAL_API_KEY=
CRYPTO_API_KEY=

# ---------- 4) موتور هوش مصنوعی ----------
LOVABLE_API_KEY=
OPENAI_API_KEY=

# ---------- 5) پایگاه داده ----------
# VITE_* فقط برای client-safe/public configuration است.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only values used by SupabasePersistenceRepository:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PERSISTENCE_TIMEOUT_MS=8000
# اختیاری برای استقرار PostgreSQL/Neon در آینده:
DATABASE_URL=

# ---------- 6) کلیدهای امنیتی داخلی ----------
# با دستور زیر بسازید: openssl rand -hex 32
SESSION_SECRET=
